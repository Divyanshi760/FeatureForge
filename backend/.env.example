# Port the server listens on (Render injects this automatically in production)
PORT=5000

# MongoDB connection string. Local example shown; in production use a
# MongoDB Atlas URI, e.g. mongodb+srv://user:pass@cluster.mongodb.net/featureforge
MONGO_URI=mongodb://127.0.0.1:27017/featureforge

# Secret used to sign JWTs. MUST be a long, random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_secret

# Comma-separated list of allowed frontend origins for CORS.
# Leave unset to allow all origins (fine for local dev).
# In production set to your Vercel URL, e.g. https://your-app.vercel.app
CORS_ORIGIN=
